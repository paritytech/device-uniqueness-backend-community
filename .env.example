# Device Uniqueness Backend — local dev environment variables
# Copy this file to `.env` and adjust values as needed.
# Docker Compose auto-loads `.env` from this directory.

# --- environment identity ---

# Names this environment. Every service joins the shared `dub-edge` network
# under an alias suffixed with it (device-attestation-api-$ENV_ID, …), which is what the
# gateway's site blocks resolve and what lets two environments with identical
# service names share one host. The ids the reference deployments use are
# `paseo-next-v2`, `previewnet`, `products-devnet` and `polkadot`; any string is
# accepted, so pick one and keep it stable for the life of the environment.
#
# NOT to be confused with PEOPLE_NETWORK, which stays `paseo` — that is a wire
# literal the shipping clients parse, on a different axis.
ENV_ID=paseo-next-v2

# --- images ---

# ONE image, $IMAGE_REPO:$IMAGE_TAG, run by every service with a different
# `--role` (see each service's `command:`). Build it with
# `docker buildx bake all` (one cargo build, one image — see docker-bake.hcl),
# or pull a published one with `docker compose pull`.
#
# IMAGE_REPO is a full repository path, not a registry: the tag is appended
# directly, so a registry move is a change to this one value.
# scripts/verify_role_split.sh fails CI if the services drift onto different
# image references, or name a role the binary does not accept.
IMAGE_REPO=device-uniqueness-backend
IMAGE_TAG=local

# --- debug-overlay host ports ---

# Read ONLY by docker-compose.debug.yml, which republishes the service and
# Postgres ports on 127.0.0.1. The base compose file publishes nothing, so
# without that overlay none of these apply. A second environment on the same
# host must shift the whole band before layering the overlay, or it collides
# with the first one's published ports.
DEVICE_ATTESTATION_POSTGRES_PORT=5432       # also overridden by the `just test-live` lane
INDEXER_POSTGRES_PORT=5433
INVITE_POSTGRES_PORT=5435
DEVICE_ATTESTATION_PORT=8080
INDEXER_PORT=8081
INVITE_PORT=8083
TURN_PORT=8084
NOTIFY_PORT=8085

# --- device-attestation-api ---

# Listen address (default: 0.0.0.0:8080 when set via compose)
BIND_ADDR=0.0.0.0:8080

# Postgres connection string for running a binary on the HOST (`cargo run`).
# It does NOT reconfigure the compose containers: they build their own URL from
# the three DEVICE_ATTESTATION_DB_* vars below, which is why this line can point
# at localhost without aiming every container at its own loopback. Reaching
# Postgres over localhost needs the debug overlay — the base compose file
# publishes no host port:
# `docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d postgres`
DEVICE_ATTESTATION_DATABASE_URL=postgres://device_attestation:device_attestation@localhost:5432/device_attestation

# The role, password and database the compose `postgres` service initialises
# with, and the three pieces every container's DEVICE_ATTESTATION_DATABASE_URL
# is built from (the host is always the `postgres` service, so it is not a knob
# here). The defaults are what a fresh volume gets — leave them alone unless
# this environment's volume predates the identity -> device_attestation rename,
# in which case set all three to the old names and skip the database migration
# entirely (docs/runbook.md, Option A). The image reads POSTGRES_* only when it
# initialises an EMPTY data directory, so an existing volume keeps whatever it
# was created with no matter what these say.
# DEVICE_ATTESTATION_DB_USER=device_attestation
# DEVICE_ATTESTATION_DB_PASSWORD=device_attestation
# DEVICE_ATTESTATION_DB_NAME=device_attestation

# People Chain RPC URL (PreviewNet is the default, paired with the
# ASSET_HUB_RPC_URL below so the dotNS lane claims labels on the same network
# it attests usernames on). Paseo Next v2 is
# wss://paseo-people-next-system-rpc.polkadot.io — set DOTNS_GATEWAY_ENABLED=false
# with it, because Paseo's Asset Hub runs a different reserve_name.
PEOPLE_RPC_URL=wss://previewnet.substrate.dev/people

# JWT signing key — 32-byte Ed25519 seed as 0x-prefixed 64-char hex
JWT_ED25519_SECRET=0x0101010101010101010101010101010101010101010101010101010101010101

# Attester authority (SS58) — read by both device-attestation-api (published at
# GET /api/v1/attester) and device-attestation-chain-writer (attests as it). The writer
# signs directly when this is CHAIN_WRITER_SIGNER_SURI's own account and
# proxies for it otherwise; the default below is //Alice, i.e. direct in dev.
ATTESTER_ACCOUNT=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY

# Attestation gating
AUTH_ENABLED=false
ENFORCE_AUTH=false

# Registration queue (spec: balance-priority FIFO). false = M0 direct-to-writer
# flow and wire. true = every free-lane claim waits as a QUEUED row with a
# priority group from the subject's on-chain balance, drained ONLY by the
# separate registration-queue service — the queue is the free lane's
# throughput control, so a down queue service parks claims (the writer warns
# about stranded rows) instead of falling back to the unthrottled direct
# path. Read by device-attestation-api AND device-attestation-chain-writer; the two must always
# see the same value.
QUEUE_ENABLED=false

# Registration vouchers (eligibility slice, INSTANT lane). false = the frozen
# wire: `lifetimePoUDVoucher` on POST /api/v1/usernames is ignored. true = a
# valid voucher bypasses the device gate and the queue and registers directly
# (202 + registrationOutcome: "INSTANT"); a spent/unknown/expired voucher
# rejects the claim (400). Mint vouchers with the `voucher-mint` CLI — there
# is no HTTP mint surface; only sha256 hashes are stored.
REGISTRATION_VOUCHERS_ENABLED=false

# Widevine dedup (PoUD Android device uniqueness on POST /api/v1/usernames;
# wire spec: envelope-wire-spec v1). false = the three evidence fields
# (attestationChain, deviceEnvelope, envelopeSignature) are ignored entirely.
# true = evidence is verified (attestation chain + canonical CBOR envelope +
# leaf-key signature), the device HMAC computed, and the would-be dedup
# outcome logged — routing unchanged (soft mode) until
# WIDEVINE_DEDUP_ENFORCE is also true, which routes seen devices and
# evidence-less Android claims to the payment outcome and reserves unseen
# devices atomically with the claim. Read by device-attestation-api.
WIDEVINE_DEDUP_ENABLED=false
WIDEVINE_DEDUP_ENFORCE=false
# Accept level=3 envelopes from official locked GrapheneOS builds into the
# isolated widevine_l3 namespace (never merged with widevine_l1). Off, such
# evidence routes as evidence-absent.
WIDEVINE_L3_GRAPHENEOS_ENABLED=false
# Epoch-labelled HMAC-SHA256 secrets pseudonymizing the raw Widevine device
# id (which is never stored or logged). Comma-separated <epoch>:<key>, each
# key 32 bytes as hex or base64, ACTIVE EPOCH FIRST — new device records use
# the first key, lookups run across all of them (dual lookup during
# rotation). Required when WIDEVINE_DEDUP_ENABLED=true.
# WIDEVINE_DEDUP_HMAC_KEYS=v1:<32-byte-hex-or-base64>

# Payment lane (eligibility slice, PAYMENT_REQUIRED quote). false = a device-
# gate block keeps the frozen bare {"registrationOutcome":"PAYMENT_REQUIRED"}
# dead end. true = blocked claims (seen device, or missing device token in
# hard mode) get deposit instructions: the subject's deterministic deposit
# address (the threshold-1 multisig of PAYMENT_MASTER_ACCOUNT and a keyless
# dummy hashed from the subject) plus PAYMENT_AMOUNT_PLANCK, and the
# validated claim is stored for automatic registration on the confirmed
# deposit. The service holds no payment keys and the payer has no rights over
# the deposit account; the master-key holder sweeps with
# Multisig.as_multi_threshold_1 (re-deriving each dummy from the row's
# subject). One address per subject: sweep promptly — under cumulative-
# balance detection, balance left from an earlier request counts toward the
# subject's next quote. Both vars are required when the lane is on; the
# amount must clear the chain's existential deposit.
PAYMENT_LANE_ENABLED=false
# PAYMENT_MASTER_ACCOUNT=
# PAYMENT_AMOUNT_PLANCK=10000000000
# Quote lifetime; an unpaid request past this expires (client re-claims).
PAYMENT_REQUEST_TTL_SECS=86400
# Cadence of the chain-writer's payment watch pass (deposit detection +
# quote expiry). Read-only on chain; a no-op while no quotes exist.
PAYMENT_POLL_INTERVAL_SECS=30

# Accept the optional DotNS registration block, and submit
# DotnsGateway::reserve_name on Asset Hub. Both halves, one switch.
#
# ON in this file, because the two URLs it depends on both name PreviewNet: the
# People endpoint above and the Asset Hub endpoint below. PreviewNet is the only
# Asset Hub running the signed_at reserve_name shape this backend encodes.
#
# The pairing is the whole safety property. reserve_name writes LiteLabelOwner,
# a GLOBAL claim on the label, so a writer attesting usernames on one network's
# People while claiming their labels on another network's Asset Hub produces a
# claim on the wrong chain that cannot be undone — only the client holds the key
# that could re-sign. If you repoint PEOPLE_RPC_URL at a different network, set
# DOTNS_GATEWAY_ENABLED=false in the same edit unless you are also repointing
# ASSET_HUB_RPC_URL to that network's Asset Hub. For Paseo next that means:
#   PEOPLE_RPC_URL=wss://paseo-people-next-system-rpc.polkadot.io
#   DOTNS_GATEWAY_ENABLED=false
# Paseo next's Asset Hub still runs the older reserve_name (ring_vrf_key +
# proof_of_ownership, no signed_at), so the lane has nothing to submit there.
DOTNS_GATEWAY_ENABLED=true

# Asset Hub RPC endpoint (chain-writer only). REQUIRED when the gateway is on;
# ignored while it is off. Must be the Asset Hub of the same network
# PEOPLE_RPC_URL names — see the warning above.
ASSET_HUB_RPC_URL=wss://previewnet.substrate.dev/asset-hub

# Maximum age of dotns.signedAt in seconds (>=0; 0 requires a current timestamp).
DOTNS_INTAKE_FRESHNESS_MAX_AGE_SECS=600

# Maximum tolerated future clock skew for dotns.signedAt in seconds (>=0).
# Matches the gateway pallet's MaxFutureSkewSeconds
DOTNS_MAX_FUTURE_SKEW_SECS=30

# iOS App Attest (required non-empty when AUTH_ENABLED=true; ignored otherwise).
# App IDs are TEAMID.bundleId; rpIdHash in attestations/assertions must match one.
# APPLE_APP_ATTEST_APP_IDS=TEAMID.io.pcf.polkadotapp,TEAMID.io.pcf.polkadotapp.nightly
# Bundle ids accepted in the Auth-iOS-Package header.
# IOS_PACKAGE_NAMES=io.pcf.polkadotapp,io.pcf.polkadotapp.nightly
# Android attestation (required when AUTH_ENABLED=true; ignored otherwise).
# Package names accepted in key-attestation (and later Play Integrity) verdicts.
# ANDROID_PACKAGE_NAMES=io.pcf.polkadotapp,io.pcf.polkadotapp.nightly
# SHA-256 signing-certificate fingerprints (colon-separated or bare hex; the
# per-environment values come from the Play Console signing-key fingerprints).
# Play Store channel -> appFromOfficialStore=true; website/vanilla -> false.
# ANDROID_SIGNING_DIGEST_PLAYSTORE=7B:47:1D:1B:BC:16:F8:FD:81:1F:09:AC:E1:C0:54:1B:A4:62:E6:26:7A:2B:7B:6A:BB:EC:3F:6D:FB:EA:30:61
# ANDROID_SIGNING_DIGEST_WEBSITE=5A:A3:A6:D7:C8:F2:DE:24:2C:B0:E9:77:62:E2:E5:52:5B:0A:49:89:90:AF:E8:50:63:55:B6:F4:CB:31:27:5C
# Google's attestation revocation list; default is correct — do not override
# outside tests (a non-Google endpoint means revoked devices still pass).
# ANDROID_ATTESTATION_CRL_URL=https://android.googleapis.com/attestation/status
# CRL cache TTL in seconds (default 3600 = 1 hour, per the attestation spec)
# ANDROID_ATTESTATION_CRL_CACHE_TTL_SECS=3600
# Max age a cached CRL may reach while refreshes fail before it is refused
# (hard-mode 503). Default 3600 = 1 hour maximum staleness (spec SC-004).
# ANDROID_ATTESTATION_CRL_MAX_STALE_SECS=3600
# Play Integrity (self-managed response encryption keys; optional until the
# Play Console key exchange with the Android team lands — without them every
# play-integrity verdict fails, posture-gated by ENFORCE_AUTH).
# Verdict acceptance mode: strict (production) | relaxed_device (nightly/paseo)
# | relaxed_all (preview/debug)
# PLAY_INTEGRITY_MODE=strict
# AES-256 response decryption key, base64 (from the Play Console .enc bundle)
# PLAY_INTEGRITY_DECRYPTION_KEY=
# EC P-256 verification key, base64 DER SPKI (same bundle)
# PLAY_INTEGRITY_VERIFICATION_KEY=
# TEMPORARY fallback until the self-managed keys land: GOOGLE_CREDENTIALS
# (base64-encoded service-account JSON) enables decoding via Google's
# decodeIntegrityToken API. Self-managed keys take precedence when set.
# Delete this var (and the fallback) after the key exchange.
# GOOGLE_CREDENTIALS=
# Apple DeviceCheck (iOS uniqueness at username claim; attestation plan
# Phase 4). Disabled by default; when enabled the three key vars are required
# and the .p8 key must parse at startup.
# DEVICE_CHECK_IOS_ENABLED=false
# APPLE_TEAM_ID=P2PX3JU8FT
# DEVICE_CHECK_KEY_ID=
# .p8 PEM contents; \n-escaped single-line values are accepted
# DEVICE_CHECK_PRIVATE_KEY=
# Default is Apple production; use https://api.development.devicecheck.apple.com/v1 for dev
# DEVICE_CHECK_URL=https://api.devicecheck.apple.com/v1
# Log level (default: info)
RUST_LOG=info

# Log format (every service and worker): `json` for one JSON object per event,
# anything else for text. Compose defaults containers to `json` — that is what
# makes the aggregated logs queryable by field — while the binaries default to
# text for `just run`. The service/environment/container are not in the body:
# the log shipper labels them from Docker metadata.
LOG_FORMAT=json

# Prometheus exporter (every service and worker). Served on its own port,
# reachable only from the private `dub-metrics` network — never published to
# the host and never routed through the edge. Unset/garbage counts as enabled:
# a typo here must not silently blind the deployment.
METRICS_ENABLED=true
METRICS_ADDR=0.0.0.0:9090

# --- observability project (metrics + logs UI) ---
#
# Read by `observability/docker-compose.yml`, its own compose project
# (`-p observability`). All three UIs bind loopback only; reach them over an SSH
# tunnel. GRAFANA_ADMIN_PASSWORD only matters for what a read-only anonymous
# viewer cannot do.
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9091
# ALLOY_PORT=12345
# GRAFANA_ADMIN_PASSWORD=admin

# --- device-attestation-chain-writer ---

# Signer secret URI (default: //Alice for dev). In prod, the least-privilege
# proxy key of the ATTESTER_ACCOUNT authority above.
CHAIN_WRITER_SIGNER_SURI=//Alice

# MAXIMUM rows claimed and submitted per pass, not a fixed batch size. One pass
# is one Utility.force_batch extrinsic, and each lane (People, Asset Hub) holds
# its own adaptive size: halved on a whole-batch failure (floor 1), grown by one
# per successful submission, capped here. Watch dub_chain_batch_size{lane} to
# see the size actually in use; if it settles well below this value, the chain's
# per-block weight budget is the real ceiling — lower this to near it so a fresh
# writer does not re-run the halving search on every restart.
CHAIN_WRITER_BATCH_SIZE=25

# Attester-resources watch: every ATTESTER_RESOURCE_POLL_SECS the writer reads
# PeopleLite::AttestationAllowance plus the free balances and logs one
# attester_resources INFO line, warning below the floors below. The allowance
# is the authority's (ATTESTER_ACCOUNT) while fees come from
# CHAIN_WRITER_SIGNER_SURI, so they are separate floors. Read-only on chain.
ATTESTER_RESOURCE_POLL_SECS=60
# Remaining attestations below which the writer warns.
ATTESTER_ALLOWANCE_FLOOR=100
# Signer free balance, in planck, below which the writer warns (default 1 PAS).
ATTESTER_SIGNER_BALANCE_FLOOR_PLANCK=10000000000

# Janitor grace, used only with QUEUE_ENABLED=false: how long the
# registration-queue service's lease may be expired before the writer drains
# leftover QUEUED rows into the direct path (retiring the queue strands
# nothing; a live advancer gets to finish a fair drain first). With
# QUEUE_ENABLED=true nothing is ever drained here — this only paces the
# stranded-queue warning.
QUEUE_FALLBACK_AFTER_SECS=60

# --- registration-queue ---
#
# Single-instance queue advancer (own lease). While QUEUE_ENABLED is on its
# promotion is the only queue exit — when it is down, claims park as QUEUED
# behind the throttle until it returns. Shares DEVICE_ATTESTATION_DATABASE_URL / PEOPLE_RPC_URL
# with the device-attestation section above.

# Queue advancer iteration interval, seconds (the spec's "every N seconds";
# up to 4 promotions per iteration).
QUEUE_ADVANCE_INTERVAL_SECS=6

# Advancer lease TTL, seconds. Must exceed the interval; while unexpired the
# queue counts as alive for the writer's stranded-queue warning and (with the
# queue disabled) its janitor drain.
QUEUE_LEASE_TTL_SECS=30

# --- username-indexer ---
#
# Independently deployable public search service with its own Postgres.
# The compose file sets each service's namespaced database URL / PEOPLE_RPC_URL / BIND_ADDR
# / RUST_LOG per service, so the four keys below (which collide with the device-attestation
# sections above) are documented but left commented to avoid clobbering a shared
# .env. Uncomment them only when running the `username-indexer` binary directly.

# Postgres connection string for the username-indexer projection (its own DB)
INDEXER_DATABASE_URL=postgres://username_indexer:username_indexer@localhost:5433/username_indexer

# People Chain RPC URL (mirrors the device-attestation default: PreviewNet)
# PEOPLE_RPC_URL=wss://previewnet.substrate.dev/people

# Listen address
# BIND_ADDR=0.0.0.0:8080

# Finalized storage scan page size (1..=1000)
STORAGE_PAGE_SIZE=1000

# Finalized poll interval, seconds (1..=86400)
SYNC_INTERVAL_SECS=30

# Public search rate limit: requests per window per client IP (>=1). This is the
# outermost layer on the route and does no crypto, so an exhausted window cannot
# be used to force JWT verification or puzzle hashing.
SEARCH_RATE_LIMIT=60

# Public search rate-limit window, seconds (>=1)
SEARCH_RATE_LIMIT_WINDOW_SECS=60

# Proof-of-compute gate on public search. OFF by default: with it off there is no
# `POST /api/v1/poc/issue` route and search behaves exactly as before.
#
# When ON the gate is either-or — a valid device-attestation JWT satisfies search
# just as a solved puzzle does, so the shipping mobile apps (which authenticate
# search) need no change and only anonymous callers must mine. Turning it on
# therefore requires verify-only JWT material (JWT_JWKS_JSON or
# JWT_ED25519_PUBLIC_KEY) or the process refuses to boot.
POC_ENABLED=false

# Input keying material for the puzzle HMAC (HKDF-SHA256). REQUIRED when
# POC_ENABLED=true (min 32 chars of random material —
# HKDF adds no entropy and every puzzle publishes a message/HMAC pair, so a weak
# secret is recoverable offline); ignored otherwise.
# POC_HMAC_SECRET=

# Required leading zero bits in a solution (1..=32).
# Puzzle validity (60s) and clock-skew tolerance (30s) are fixed constants.
POC_DIFFICULTY_BITS=16

# Log level
# RUST_LOG=info

# --- invite-tickets ---
#
# Synchronous invitation-credential claim service (the route the shipping apps
# call) with its own Postgres. Its database URL and rate limit are namespaced
# (INVITE_TICKETS_*), so they collide with nothing and need not stay commented.

# Network literal stamped into rows and responses (required; westend2|paseo|polkadot).
# Shared with invite-tickets-pool below — one chain, one network literal.
PEOPLE_NETWORK=paseo

# Verify-only JWT key material (required; exactly one of these two):
# an inline JWKS document as served by device-attestation at /.well-known/jwks.json…
# JWT_JWKS_JSON={"keys":[…]}
# …or a pinned 32-byte Ed25519 public key as hex. This dev default is the
# public key of the dev JWT_ED25519_SECRET above.
JWT_ED25519_PUBLIC_KEY=0x8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c

# Postgres connection string for the invite-tickets pool (its own DB)
INVITE_TICKETS_DATABASE_URL=postgres://invite_tickets:invite_tickets@localhost:5435/invite_tickets

# Per-subject rate limit on the claim route: requests per window (>=1), and the
# window in seconds (>=1). Namespaced, so tuning this does not also retune
# turn-api.
INVITE_TICKETS_RATE_LIMIT=30
INVITE_TICKETS_RATE_LIMIT_WINDOW_SECS=60

# Listen address (api role; the pool role has no HTTP)
# BIND_ADDR=0.0.0.0:8080

# --- invite-tickets-pool ---
#
# Single-instance pool maintainer (one inviter = one nonce lane; never scale
# it). MUST NOT share a signing account with any other chain writer — compose
# interpolates these INVITE_INVITER_* host vars into the container's
# INVITER_* env so this pool keeps its own dev account (//Bob), distinct from
# the device-attestation chain writer's. See docs/deploy.md "Nonce lanes".

# Invite inviter: its on-chain AvailableInvites funds tickets; stamped into rows
INVITE_INVITER_ADDRESS=5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty

# Invite inviter signing secret: same accepted formats as the writers above,
# and the same derived proxying (a delegate key proxies for
# INVITE_INVITER_ADDRESS; its own key signs directly)
INVITE_INVITER_SIGNER_SURI=//Bob

# Pool tunables
POOL_DIMS=Game,ProofOfInk       # comma-separated subset of Game,ProofOfInk
POOL_TARGET_SIZE=10000          # 1..=10000000 available tickets per pool
POOL_BATCH_MAX=100              # 1..=1000; AIMD: grow by 1, halve on failure
POOL_INTERVAL_SECS=6            # 1..=86400
POOL_FINALIZE_SECS=60           # 1..=86400; covers submit through finalization

# --- turn-api ---
#
# Stateless TURN credential issuer (safe to scale). Run one instance per
# environment when proof issuance is enabled: each process pins one People
# Chain RPC + genesis and keeps that environment's ring-root cache. The secret + algorithm
# MUST match the TURN relay's coturn `--use-auth-secret` configuration, or
# minted credentials will not authenticate; rotate relay + issuer together.

# Base64-encoded HMAC secret shared with the TURN relay (required — turn-api
# refuses to boot without valid base64, so this file ships a working DEV value
# rather than a placeholder that crash-loops a fresh `docker compose up`).
#
# THIS VALUE IS PUBLIC. It is the literal string "dev-only-turn-secret-change-me"
# in base64, it is committed to a public repository, and anyone can read it.
# Replace it before any deployment that reaches a real relay:
#   openssl rand -base64 32
TURN_SECRET=ZGV2LW9ubHktdHVybi1zZWNyZXQtY2hhbmdlLW1l

# HMAC algorithm: SHA1 (coturn default) | SHA256 | SHA384 | SHA512
TURN_AUTH_ALGORITHM=SHA1

# Credential TTL in seconds
TURN_TTL_SECS=1800

# Per-subject rate limit on the issue route: requests per window (>=1), and the
# window in seconds (>=1). Namespaced, so tuning this does not also retune
# invite-tickets.
TURN_RATE_LIMIT=30
TURN_RATE_LIMIT_WINDOW_SECS=60

# TURN realm (configured on the relay; reserved here — validated, not on the wire)
TURN_REALM=example.org

# Comma-separated ICE server URLs echoed verbatim in every 201 body
ICE_SERVERS=stun:stun.example.com:3478,turn:turn.example.com:3478?transport=udp

# Proof-authorized issuance (POST /api/v1/turn/issue-with-proof): TURN
# credentials for a proven Lite/Full person without an app-integrity JWT, in
# one request. Off by default; when enabled, every environment's checkout sets
# its own RPC/genesis while product ids remain runtime configuration. Every deployment-specific value
# below is required with no default (fail closed). The two canonical
# personhood collections are fixed in code and independently refreshed.
TURN_PROOF_ENABLED=false

# People Chain RPC the background ring-root refresher connects to. The
# listener never waits on it: a dead chain leaves /turn/issue untouched and
# the proof route answers 503 until the first snapshot.
# TURN_PROOF_RPC_URL=wss://previewnet.substrate.dev/people

# Genesis hash this deployment is bound to (32-byte hex). The root refresher
# refuses a chain reporting a different genesis.
# TURN_PROOF_GENESIS=0x<32-byte-hex>

# Products whose proofs are accepted, comma-separated. The server derives one
# context per product as blake2b256("product/" ++ productId ++ "/" ++
# indexBytes(TURN_PROOF_CONTEXT_SUFFIX)) and verifies each request under the
# context of the `productId` it names, so a product proves under its own
# identifier and the host does not prompt the user. A product not listed here
# is refused before any verification work.
# TURN_PROOF_PRODUCTS=vox.dot,game.dot

# Derivation index for every product context (default 0). Only change this to
# move all products to a fresh context generation; it invalidates every alias.
# TURN_PROOF_CONTEXT_SUFFIX=0

# Concurrent ring-VRF verifications. `auto` uses available CPUs minus one
# (floor 1), leaving capacity for the JWT route. A positive integer overrides
# it. Up to 64 saturated requests wait 50ms, then fail with 503 + Retry-After.
# TURN_PROOF_CONCURRENCY=auto

# Per-person proof issuance reuses RATE_LIMIT and RATE_LIMIT_WINDOW_SECS.
# The accepted clock skew and root refresh cadence are fixed at 60s and 30s.


# --- notifications (notify-relay) ---
#
# Stateless, DB-free `/api/v1/notify` relay. It is verify-only: it validates
# device-attestation's JWT with the public key below and never holds a signing key.
# BIND_ADDR / RUST_LOG collide with the sections above, so they are left commented
# to avoid clobbering a shared .env; uncomment when running notify-relay directly.

# device-attestation's Ed25519 JWT PUBLIC key — 0x-prefixed 64-char hex.
# This is the public half of device-attestation's JWT_ED25519_SECRET. For the dev
# secret above (seed 0x0101..01) the matching public key is:
JWT_ED25519_PUBLIC_KEY=0x8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c
# Alternatively, set JWT_JWKS_JSON to device-attestation's /.well-known/jwks.json
# body — a non-empty value wins over JWT_ED25519_PUBLIC_KEY.
# JWT_JWKS_JSON=

# Listen address
# BIND_ADDR=0.0.0.0:8080

# Log level
# RUST_LOG=info

# Per-subject rate limit for POST /api/v1/notify: requests per window per
# authenticated JWT subject (accountId), keyed on subject+route, never raw IP.
NOTIFY_RATE_LIMIT=60

# Notify rate-limit window, seconds (>=1)
NOTIFY_RATE_LIMIT_WINDOW_SECS=60

# iOS APNs provider (optional; unset = unconfigured stub). Point APNS_KEY_FILE at
# your .p8 anywhere on the host; compose mounts it read-only (no key in the repo).
# It must be readable by the container user: chown 10001:10001 + chmod 0400.
# Running the binary directly? Use APNS_PRIVATE_KEY_FILE (path) or APNS_PRIVATE_KEY
# (inline PEM). Key id + team id + topic + environment are required with the key.
# APNS_KEY_FILE=/absolute/path/to/AuthKey_XXXX.p8
# APNS_KEY_ID=73L6WWUQ3F
# APNS_TEAM_ID=P2PX3JU8FT
# APNS_TOPIC=io.parity.brevity
# APNS_ENVIRONMENT=development   # or production (App Store / TestFlight)
# Sets which APNs host is tried FIRST. A device token is bound to one
# environment, so a token rejected as BadDeviceToken is retried once against the
# other host — one relay serves both TestFlight and local Xcode builds.

# Android FCM provider (optional). When FCM_SERVICE_ACCOUNT_JSON is set the relay
# wires the real FCM provider for Android; when absent, Android pushes report
# provider failure (unconfigured stub). The value is the full Firebase
# service-account JSON (project_id + client_email + private_key). Keep secret.
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
